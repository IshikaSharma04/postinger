{
  "manifest_version": 3,
  "name": "Postinger — Save to Ideas",
  "version": "1.0.0",
  "description": "Clip any webpage, selected text, or online image straight into your Postinger ideas board.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://*.postinger.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Postinger"
  },
  "background": {
    "service_worker": "background.js"
  }
}
