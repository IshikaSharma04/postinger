# ──────────────────────────────────────────────────────────────────────────────
# Postly — Environment Variables Example
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── App Configuration ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=postly
POSTGRES_PASSWORD=postly_dev_password
POSTGRES_DB=postly_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postly:postly_dev_password@localhost:5432/postly_db?schema=public"

# ── Redis & Queue ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_dev_password
REDIS_PORT=6379
REDIS_URL="redis://:redis_dev_password@localhost:6379"

# ── NextAuth Authentication ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace_with_a_random_32_byte_hex_string
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true

# ── Media Storage ─────────────────────────────────────────────────────────────
# Local file uploads are stored in ./public/uploads
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=50

# ── AI Copywriting Assistant (Optional) ────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_placeholder

# ── Social Platform Integrations (Optional / Production) ───────────────────────
# When left blank, Postly runs in Sandboxed / Simulated Mode.
TWITTER_CLIENT_ID=your_twitter_client_id_placeholder
TWITTER_CLIENT_SECRET=your_twitter_client_secret_placeholder

META_APP_ID=your_meta_app_id_placeholder
META_APP_SECRET=your_meta_app_secret_placeholder

LINKEDIN_CLIENT_ID=your_linkedin_client_id_placeholder
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_placeholder

TIKTOK_CLIENT_KEY=your_tiktok_client_key_placeholder
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_placeholder

PINTEREST_APP_ID=your_pinterest_app_id_placeholder
PINTEREST_APP_SECRET=your_pinterest_app_secret_placeholder

GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
